<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>8c7548eb-84f6-4563-b06c-53075f80f652</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core tooling must be referenced by the startup project for `dotnet ef`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastAddress.Api.Database\FastAddress.Api.Database.csproj" />
    <ProjectReference Include="..\FastAddress.Api.Services\FastAddress.Api.Services.csproj" />
    <ProjectReference Include="..\FastAddress.Api.Vendors\FastAddress.Api.Vendors.csproj" />
    <ProjectReference Include="..\FastAddress.Sdk\FastAddress.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FastAddress.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
