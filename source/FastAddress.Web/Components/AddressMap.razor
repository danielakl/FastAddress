@using FastAddress.Web.Models
@using FastAddress.Web.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SearchState State

<div class="relative h-96 w-full overflow-hidden rounded-2xl border border-line shadow-sm">
    @* `isolate` contains Leaflet's internal z-index:400 panes in their own stacking context so they
       don't paint over the search dropdown or the overlay controls below. *@
    <div @ref="_mapElement" class="size-full isolate"></div>

    <div class="absolute right-3 top-3 z-10 flex select-none items-center gap-2">
        @if (State.BiasLocation is { } bias)
        {
            <span data-testid="search-location-label"
                  class="flex items-center gap-2 rounded-lg bg-panel/90 px-3 py-1.5 text-xs font-medium text-ink shadow-sm backdrop-blur">
                <span class="font-mono">Location lat: @bias.Latitude.ToString("F2"), lon: @bias.Longitude.ToString("F2")</span>
                <button type="button"
                        data-testid="search-location-clear"
                        @onclick="ClearLocationAsync"
                        aria-label="Clear search location"
                        class="grid size-4 place-items-center rounded-full text-muted transition hover:bg-line hover:text-ink">
                    <svg class="size-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M5 5l10 10M15 5L5 15" />
                    </svg>
                </button>
            </span>
        }
        else
        {
            <button type="button"
                    data-testid="search-location-toggle"
                    @onclick="ToggleSetModeAsync"
                    class="@ToggleButtonClasses">
                <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M10 2C6.7 2 4 4.7 4 8c0 4.2 6 10 6 10s6-5.8 6-10c0-3.3-2.7-6-6-6Z" />
                    <circle cx="10" cy="8" r="2" />
                </svg>
                @(State.IsSettingLocation ? "Set location" : "No search location")
            </button>
        }
    </div>
</div>

@code {
    private const string ModulePath = "./Components/AddressMap.razor.js";

    // Default view centers on Trondheim, Norway (matches the seeded address data).
    private const double DefaultLatitude = 63.4305;
    private const double DefaultLongitude = 10.3951;
    private const int DefaultZoom = 13;

    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<AddressMap>? _selfRef;

    private string ToggleButtonClasses =>
        "flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium shadow-sm backdrop-blur transition "
        + (State.IsSettingLocation ? "bg-accent text-white" : "bg-panel/90 text-ink hover:bg-panel");

    protected override void OnInitialized() => State.Changed += OnStateChangedAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _selfRef = DotNetObjectReference.Create(this);
            _map = await _module.InvokeAsync<IJSObjectReference>(
                "createMap", _mapElement, _selfRef, DefaultLatitude, DefaultLongitude, DefaultZoom);
            await SyncAsync();
        }
    }

    /// <summary>Invoked from JS when the map is clicked; sets the bias while in set-location mode.</summary>
    /// <param name="latitude">Clicked latitude.</param>
    /// <param name="longitude">Clicked longitude.</param>
    [JSInvokable]
    public async Task OnMapClickedAsync(double latitude, double longitude)
    {
        if (State.IsSettingLocation)
        {
            await State.SetBiasLocationAsync(new GeoPoint(latitude, longitude));
        }
    }

    private Task ToggleSetModeAsync() =>
        State.IsSettingLocation ? State.StopSettingLocationAsync() : State.StartSettingLocationAsync();

    private Task ClearLocationAsync() => State.ClearBiasLocationAsync();

    private async Task OnStateChangedAsync()
    {
        await SyncAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncAsync()
    {
        if (_map is not null)
        {
            await _map.InvokeVoidAsync("sync", new
            {
                searched = State.SearchedLocation,
                bias = State.BiasLocation,
                setting = State.IsSettingLocation,
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChangedAsync;

        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; nothing to clean up.
        }

        _selfRef?.Dispose();
    }
}
