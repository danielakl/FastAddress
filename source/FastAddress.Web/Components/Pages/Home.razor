@page "/"
@rendermode InteractiveServer

<PageTitle>FastAddress - Street address search</PageTitle>

<section class="mx-auto w-full max-w-3xl px-6 py-10 sm:py-14">
    <header class="mb-8">
        <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Street address search</h1>
        <p class="mt-2 text-sm text-muted">
            Type to search the FastAddress API. Pick a result to drop a pin, or set a search location on the
            map to bias results toward a point.
        </p>
    </header>

    <AddressSearch OnError="HandleError" />

    <div class="mt-6">
        <AddressMap />
    </div>
</section>

<ErrorModal @ref="_errorModal" />

@code {
    private ErrorModal? _errorModal;

    private void HandleError(string message) => _errorModal?.Show(message);
}
